# ============================================
# Bihar STET AI Quiz - Environment Variables
# ============================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default admin account (created on first startup if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Scheduler
CRON_TIMEZONE=Asia/Kolkata
